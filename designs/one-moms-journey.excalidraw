    {
      "id": "_t__bGQRcC1JR7wbJDCsz",
      "type": "text",
      "x": 1557.5573798694645,
      "y": 593.5564466055021,
      "width": 603.6409428276737,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 386517837,
      "version": 3163,
      "versionNonce": 1052127997,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790741718963,
      "link": null,
      "locked": false,
      "text": "To give this particular test a storyline to follow we're going\nto tag along as @arsdehnel takes his own mom through the\nprocess of creating an AT Proto-native blog.  Full\ntransparency: creating a blog on the AT Proto is actually\nSUPER EASY; this journey is simply serving as a framework.  \n\nAs he works with her through the concepts _behind_ her new\nblog we'll explore why an AT Proto-native blog is\nfundamentally different than the traditional Web 2.0 version.\nWhile this won't cover everything within the AT Proto it's a\ngood real-world tangible concept.  \n\nPlus she's an amazing poet and writer!  So the world will get\nto enjoy all she has to offer!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To give this particular test a storyline to follow we're going to tag along as @arsdehnel takes his own mom through the process of creating an AT Proto-native blog.  Full transparency: creating a blog on the AT Proto is actually SUPER EASY; this journey is simply serving as a framework.  \n\nAs he works with her through the concepts _behind_ her new blog we'll explore why an AT Proto-native blog is fundamentally different than the traditional Web 2.0 version.  While this won't cover everything within the AT Proto it's a good real-world tangible concept.  \n\nPlus she's an amazing poet and writer!  So the world will get to enjoy all she has to offer!",
      "autoResize": false,
      "lineHeight": 1.25
    },
